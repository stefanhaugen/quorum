# QUORUM configuration
# Copy this file to .env and edit values to match your environment.
# All variables are optional; defaults are shown.

# ---- File paths ----
# Directory containing input CSVs (migration data, etc.)
QUORUM_DATA_DIR=./data

# Directory where pipeline outputs (figures, CSVs, manifests) are written
QUORUM_OUTPUT_DIR=./outputs

# Name of the migration CSV inside QUORUM_DATA_DIR
QUORUM_MIGRATION_FILENAME=international_migration_flow.csv

# ---- HDX HAPI ----
# Base URL; rarely needs changing
QUORUM_HAPI_BASE_URL=https://hapi.humdata.org

# App identifier sent to HAPI (any stable string is fine)
QUORUM_HAPI_APP_ID=quorum_thesis

# Per-request timeout in seconds
QUORUM_HAPI_TIMEOUT=30

# Records per page when paginating
QUORUM_HAPI_PAGE_LIMIT=1000

# Cache time-to-live in hours. 0 disables TTL (entries live forever).
QUORUM_CACHE_TTL_HOURS=168

# ---- Analysis window ----
# Years over which migration and feature data are merged
QUORUM_OVERLAP_YEAR_MIN=2020
QUORUM_OVERLAP_YEAR_MAX=2022

# Primary lag (years) between feature observation and migration response
QUORUM_PRIMARY_LAG=1

# ---- Logging ----
# One of DEBUG, INFO, WARNING, ERROR
QUORUM_LOG_LEVEL=INFO

# Set to "json" for structured logs suitable for production aggregators
QUORUM_LOG_FORMAT=human
